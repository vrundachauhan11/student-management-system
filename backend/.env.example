# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas connection URI pointing to database 'studentDB'
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentDB?retryWrites=true&w=majority

# CORS Authorized Origins
# Comma-separated list of allowed client origins (e.g. your local Vite dev server and deployed Netlify URL)
CLIENT_URL=http://localhost:5173,https://your-app-name.netlify.app
